# Rename this file to .env and fill in your keys

PORT=5007

# Get free at aistudio.google.com — powers the RAG answer generation.
# Without this, the API falls back to returning raw dataset matches (still works for demo).
GEMINI_API_KEY=AIzaSyBd3ZfEaVP2c56eBKn5xLyzOtBnUfPBfQQ
GEMINI_MODEL=gemini-2.5-flash

# Bhashini (bhashini.gov.in) — Government of India's language platform.
# Free developer signup required. Powers real Assamese/Bodo/Nepali speech-to-text
# and text-to-speech, which browser Web Speech API does NOT support.
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Optional: self-hosted or alternate LibreTranslate instance for better uptime.
# Default public instance: https://libretranslate.de/translate
LIBRETRANSLATE_URL=https://libretranslate.de/translate
